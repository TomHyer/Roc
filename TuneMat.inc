// Even and odd functions of board material. Bishop x bishop-pair quadratics are omitted.
struct MatFeatures
{
	array<double, 6> odd;
	array<double, 42> even;
	array<double, 6> w_adv;
};

inline MatFeatures features_from_index(int mat_index)
{
	int i = mat_index;
	int n_wq = i % 3;
	i /= 3;
	int n_bq = i % 3;
	i /= 3;
	int n_wr = i % 3;
	i /= 3;
	int n_br = i % 3;
	i /= 3;
	int n_wl = i % 2;
	i /= 2;
	int n_bl = i % 2;
	i /= 2;
	int n_wd = i % 2;
	i /= 2;
	int n_bd = i % 2;
	i /= 2;
	int n_wn = i % 3;
	i /= 3;
	int n_bn = i % 3;
	i /= 3;
	int n_wp = i % 9;
	i /= 9;
	int n_bp = i % 9;

	int n_wb = n_wl + n_wd, n_bb = n_bl + n_bd;
	int n_wbp = n_wl * n_wd, n_bbp = n_bl * n_bd;

	array<int, 7> whiteFeatures = { n_wp, n_wn, n_wb, n_wr, n_wq, n_wbp };
	array<int, 7> blackFeatures = { n_bp, n_bn, n_bb, n_br, n_bq, n_bbp };

	auto fSum = [&](int ii) { return whiteFeatures[ii] + blackFeatures[ii]; };
	auto fProd = [&](int ii) { return whiteFeatures[ii] * blackFeatures[ii]; };
	auto qSame = [&](int ii, int jj) { return whiteFeatures[ii] * whiteFeatures[jj] + blackFeatures[ii] * blackFeatures[jj]; };
	auto qCross = [&](int ii, int jj) { return whiteFeatures[ii] * blackFeatures[jj] + blackFeatures[ii] * whiteFeatures[jj]; };

	array<int, 42> evenFeatures = { fSum(0), fProd(0), fSum(1), fProd(1), fSum(2), fProd(2), fSum(3), fProd(3), fSum(4), fProd(4), fSum(5), fProd(5), n_wl * n_bl + n_wd * n_bd, n_wl * n_bd + n_bl * n_wd,
			qSame(0, 1), qCross(0, 1), qSame(0, 2), qCross(0, 2), qSame(0, 3), qCross(0, 3), qSame(0, 4), qCross(0, 4), qSame(0, 5), qCross(0, 5), qSame(1, 2), qCross(1, 2), qSame(1, 3), qCross(1, 3),
			qSame(1, 4), qCross(1, 4), qSame(1, 5), qCross(1, 5), qSame(2, 3), qCross(2, 3), qSame(2, 4), qCross(2, 4), qSame(3, 4), qCross(3, 4), qSame(3, 5), qCross(3, 5), qSame(4, 5), qCross(4, 5) };

	MatFeatures f;
	array<int, 6> oddFeatures = { n_wp - n_bp, n_wn - n_bn, n_wb - n_bb, n_wr - n_br, n_wq - n_bq, n_wbp - n_bbp };
	array<int, 6> wAdvantage = { n_wp - n_bp, n_wn - n_bn, n_wb - n_bb, n_wr - n_br, n_wq - n_bq, 1 };
	for (int k = 0; k < 6; ++k)
	{
		f.odd[k] = oddFeatures[k];
		f.w_adv[k] = wAdvantage[k];
	}
	for (int k = 0; k < 42; ++k)
		f.even[k] = evenFeatures[k];
	return f;
}

template<int N_LAYERS>
struct MatModel_
{
	array<array<double, 6>, 5> odd1_{};
	array<array<double, 42>, 6> even1_{};
	array<array<array<double, 6>, 6>, N_LAYERS> layers_{};
	array<array<double, 6>, N_LAYERS> biases_{};

	array<double, 6> hidden(const array<double, 42>& even) const
	{
		array<double, 6> h{};
		for (int ie = 0; ie < 6; ++ie)
			h[ie] = tanh(inner_product(even.begin(), even.end(), even1_[ie].begin(), 0.0));
		for (int il = 0; il < N_LAYERS; ++il)
		{
			array<double, 6> next{};
			for (int ii = 0; ii < 6; ++ii)
				next[ii] = tanh(inner_product(h.begin(), h.end(), layers_[il][ii].begin(), biases_[il][ii]));
			h = next;
		}
		return h;
	}

	double score(int mat_index) const
	{
		auto f = features_from_index(mat_index);
		array<double, 5> odd{};
		for (int io = 0; io < 5; ++io)
			odd[io] = inner_product(f.odd.begin(), f.odd.end(), odd1_[io].begin(), 0.0);
		auto h = hidden(f.even);
		double mul = (1.0 + h[5]) / 2.0;
		return min(1.0, mul) * inner_product(odd.begin(), odd.end(), h.begin(), 0.0);
	}

	pair<double, double> muls(int mat_index) const
	{
		auto f = features_from_index(mat_index);
		auto h = hidden(f.even);
		double w_dot = inner_product(f.w_adv.begin(), f.w_adv.end(), h.begin(), 0.0);
		double b_dot = 2.0 * h[5] - w_dot;
		double w_mul = max(0.0, 0.5 + tanh(w_dot));
		double b_mul = max(0.0, 0.5 + tanh(b_dot));
		if (f.odd[0] == 0 && f.odd[1] == 0 && f.odd[2] == 0 && f.odd[3] == 0 && f.odd[4] == 0 && fabs(w_mul - b_mul) > 0.000001)
		{
			cout << "Invariant failed for " << mat_index << ": " << w_mul << " vs " << b_mul << "\n";
			abort();
		}
		return make_pair(w_mul, b_mul);
	}
};
